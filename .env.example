# Copy to .env; fill privately. Never commit the result.
OPENAI_API_KEY=
SDR_OPENAI_MODEL=gpt-5.4-mini
# Genesis construction agents (independent from SDR conversations).
GENESIS_OPENAI_MODEL=gpt-6.1-sol
GENESIS_REASONING_EFFORT=high
# Optional CRM: requires a provisioned DEV database and private route file.
SDR_CRM_ROUTES_FILE=
ARKOM_CRM_DATABASE_URL=
ARKOM_CRM_CLICKMAX_PUBLIC_DEV_WORKSPACE=
ARKOM_CRM_CLICKMAX_DEV_URL=
# Name must match arkom_crm.routes.key_env in your DEV database.
ARKOM_CRM_CLICKMAX_CLIENT_EXAMPLE=
ARKOM_CRM_CLICKMAX_CLIENT_EXAMPLE_CAPTURE_URL=

# Optional local CLIPS (PostgreSQL 17 and FFmpeg).
ARKOM_CLIPS_LOCAL_ENABLED=false
ARKOM_CLIPS_FFMPEG=
# Optional: start an existing local CRM development cluster with the demo.
ARKOM_CRM_LOCAL_PG_DATA=
ARKOM_LOCAL_PG_BIN=/opt/homebrew/opt/postgresql@17/bin

# Optional Multipropriedades: existing private checkout, Node 22+, Go and local Docker.
ARKOM_MULTI_HOMOLOG_ROOT=

# Optional FinanceAI: local private checkout and dedicated simulated PostgreSQL.
ARKOM_FINANCEAI_ROOT=
