package main

import (
	solution "arkom.local/solution"
	"arkom.local/solution/platform"
	"bufio"
	"bytes"
	"encoding/json"
	"fmt"
	"net/http"
	"os"
	"strings"
	"time"
)

type dataSnapshot struct {
	Found bool            `json:"found"`
	Value json.RawMessage `json:"value,omitempty"`
}
type dataWrite struct {
	Value json.RawMessage `json:"value"`
}
type record struct {
	ID        string          `json:"id"`
	Value     json.RawMessage `json:"value"`
	CreatedAt time.Time       `json:"created_at"`
}
type recordsSnapshot struct {
	Items         []record  `json:"items"`
	NextID        string    `json:"next_id"`
	NextCreatedAt time.Time `json:"next_created_at"`
}
type request struct {
	Records *recordsSnapshot `json:"records,omitempty"`
	Data    *dataSnapshot    `json:"data,omitempty"`
	Method  string
	Path    string
	Body    string
}
type response struct {
	RecordCreate *record    `json:"record_create,omitempty"`
	DataWrite    *dataWrite `json:"data_write,omitempty"`
	Status       int        `json:"status"`
	Body         string     `json:"body"`
	ContentType  string     `json:"content_type"`
}
type writer struct {
	header http.Header
	status int
	body   bytes.Buffer
}

func (w *writer) Header() http.Header { return w.header }
func (w *writer) WriteHeader(n int) {
	if w.status == 0 {
		w.status = n
	}
}
func (w *writer) Write(b []byte) (int, error) {
	if w.status == 0 {
		w.status = 200
	}
	if w.body.Len()+len(b) > 65536 {
		panic("response_limit")
	}
	return w.body.Write(b)
}
func invoke(h http.Handler, in request) (out response) {
	defer func() {
		if recover() != nil {
			out = response{Status: 500, Body: "handler_failed", ContentType: "text/plain"}
		}
	}()
	r, e := http.NewRequest(in.Method, "http://application.invalid"+in.Path, strings.NewReader(in.Body))
	if e != nil {
		return response{Status: 400, Body: "bad_request", ContentType: "text/plain"}
	}
	r.Header.Set("Content-Type", "application/json")
	ctx, pending := requestData(r.Context(), in.Data)
	ctx, pendingRecord := requestRecords(ctx, in.Records)
	r = r.WithContext(ctx)
	w := &writer{header: make(http.Header)}
	h.ServeHTTP(w, r)
	if w.status == 0 {
		w.status = 200
	}
	ct := "text/plain"
	if strings.HasPrefix(w.header.Get("Content-Type"), "application/json") {
		ct = "application/json"
	}
	out = response{Status: w.status, Body: w.body.String(), ContentType: ct}
	if w.status >= 200 && w.status < 300 {
		out.DataWrite = pending()
		out.RecordCreate = pendingRecord()
	}
	return out
}
func main() {
	scan := bufio.NewScanner(os.Stdin)
	scan.Buffer(make([]byte, 4096), 384*1024)
	if !scan.Scan() {
		return
	}
	var init struct {
		Org string `json:"organization_id"`
	}
	if json.Unmarshal(scan.Bytes(), &init) != nil || init.Org == "" {
		return
	}
	h := solution.NewHandler(platform.Tenant{OrganizationID: init.Org})
	if h == nil {
		return
	}
	enc := json.NewEncoder(os.Stdout)
	enc.Encode(response{Status: 200, Body: "ready", ContentType: "text/plain"})
	for scan.Scan() {
		var in request
		if json.Unmarshal(scan.Bytes(), &in) != nil {
			return
		}
		if err := enc.Encode(invoke(h, in)); err != nil {
			fmt.Fprintln(os.Stderr, "response_failed")
			return
		}
	}
}
