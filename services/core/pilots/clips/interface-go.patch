diff --git a/src/lib/go-remix.ts b/src/lib/go-remix.ts
new file mode 100644
index 0000000..582dfbf
--- /dev/null
+++ b/src/lib/go-remix.ts
@@ -0,0 +1,149 @@
+import type { GoIdentity } from "@/lib/go-access";
+
+type PublicConfig = { api_url: string; installation_id: string };
+type Bootstrap = PublicConfig & { origin: string; solution: string; callback_path: string };
+type Tokens = { access_token: string; refresh_token: string; expires_in: number; installation_id: string; identity: GoIdentity };
+const proof = /^[A-Za-z0-9_-]{43}$/;
+const uuid = /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/;
+const prefix = "clips-remix.pkce.";
+let configuration: Promise<Bootstrap> | undefined;
+let initialization: Promise<GoIdentity | null> | undefined;
+let tokens: Tokens | undefined;
+let expiresAt = 0;
+let generation = 0;
+let refreshing: Promise<string> | undefined;
+const blobs = new Map<string, string>();
+const b64 = (v: Uint8Array) => btoa(String.fromCharCode(...v)).replace(/=/g, "").replace(/\+/g, "-").replace(/\//g, "_");
+const random = () => b64(crypto.getRandomValues(new Uint8Array(32)));
+const failure = () => new Error("Este acesso ainda não foi liberado para este endereço. Fale com a equipe.");
+
+async function config(): Promise<Bootstrap> {
+  if (!configuration) configuration = (async () => {
+    const response = await fetch("/clips-installation.json", { credentials: "omit", cache: "no-store", redirect: "error" });
+    if (!response.ok) throw failure();
+    const value: PublicConfig = await response.json();
+    if (Object.keys(value).sort().join(",") !== "api_url,installation_id" || !uuid.test(value.installation_id)) throw failure();
+    const api = new URL(value.api_url);
+    if (api.protocol !== "https:" || api.username || api.password || api.pathname !== "/" || api.search || api.hash || api.origin !== value.api_url) throw failure();
+    const result = await fetch(`${api.origin}/remix/v1/installations/${value.installation_id}/bootstrap`, { credentials: "omit", cache: "no-store", redirect: "error" });
+    if (!result.ok) throw failure();
+    const boot: Bootstrap = await result.json();
+    if (boot.installation_id !== value.installation_id || boot.api_url !== api.origin || boot.solution !== "clips" || boot.origin !== location.origin || boot.callback_path !== "/login") throw failure();
+    return boot;
+  })().catch(error => { configuration = undefined; throw error; });
+  return configuration;
+}
+
+async function post<T>(action: string, body: unknown): Promise<T> {
+  const c = await config();
+  const response = await fetch(`${c.api_url}/remix/v1/installations/${c.installation_id}/${action}`, {
+    method: "POST", credentials: "omit", cache: "no-store", redirect: "error", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body),
+  });
+  if (!response.ok) throw failure();
+  return response.json();
+}
+
+function accept(value: Tokens, current: number): string {
+  if (current !== generation) throw new Error("A conta mudou. Entre novamente.");
+  if (!value.access_token?.startsWith("clips_remix_access_") || !value.refresh_token?.startsWith("clips_remix_refresh_") || !uuid.test(value.installation_id) || !value.identity?.id || value.expires_in < 1 || value.expires_in > 600) throw failure();
+  if (tokens?.identity.id !== value.identity.id) clearRemixBlobs();
+  tokens = value; expiresAt = Date.now() + value.expires_in * 1000;
+  return value.access_token;
+}
+
+export async function beginRemixLogin(): Promise<void> {
+  const c = await config();
+  for (let n = sessionStorage.length - 1; n >= 0; n--) {
+    const key = sessionStorage.key(n);
+    if (key?.startsWith(prefix)) {
+      try { const prior = JSON.parse(sessionStorage.getItem(key) || "null"); if (!prior || Date.now() - prior.at > 300_000) sessionStorage.removeItem(key); }
+      catch { sessionStorage.removeItem(key); }
+    }
+  }
+  const verifier = random(), state = random();
+  const challenge = b64(new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(verifier))));
+  sessionStorage.setItem(prefix + state, JSON.stringify({ verifier, at: Date.now(), api: c.api_url, installation: c.installation_id }));
+  const result = await post<{ authorization_url: string }>("request", { state, challenge, challenge_method: "S256" });
+  const destination = new URL(result.authorization_url);
+  if (destination.origin !== c.api_url || destination.pathname !== "/remix/authorize" || !proof.test(destination.searchParams.get("request") || "") || destination.hash) throw failure();
+  location.assign(destination.toString());
+}
+
+export async function initializeRemix(): Promise<GoIdentity | null> {
+  if (!initialization) initialization = (async () => {
+    const callback = new URLSearchParams(location.hash.slice(1));
+    const code = callback.get("clips_code"), state = callback.get("state");
+    // Remove the temporary code before any API request or page navigation.
+    if (code || state) history.replaceState(null, "", location.pathname + location.search);
+    const c = await config();
+    if (!code && !state) { await beginRemixLogin(); return null; }
+    if (!code || !state || !proof.test(code) || !proof.test(state)) throw failure();
+    const key = prefix + state, raw = sessionStorage.getItem(key); sessionStorage.removeItem(key);
+    const saved = raw ? JSON.parse(raw) : null;
+    if (!saved || saved.api !== c.api_url || saved.installation !== c.installation_id || Date.now() - saved.at > 300_000 || saved.at > Date.now() || !proof.test(saved.verifier)) throw failure();
+    const value = await post<Tokens>("exchange", { code, state, verifier: saved.verifier });
+    if (value.installation_id !== c.installation_id) throw failure();
+    accept(value, generation);
+    return value.identity;
+  })();
+  return initialization;
+}
+
+async function accessToken(): Promise<string> {
+  if (!tokens) throw failure();
+  if (expiresAt > Date.now() + 30_000) return tokens.access_token;
+  if (!refreshing) {
+    const current = generation, credential = tokens.refresh_token;
+    refreshing = post<Tokens>("refresh", { refresh_token: credential }).then(value => accept(value, current)).finally(() => { refreshing = undefined; });
+  }
+  return refreshing;
+}
+
+export async function remixFetch(path: string, init?: RequestInit): Promise<Response> {
+  if (!path.startsWith("/") || path.startsWith("//") || path.includes("\\")) throw failure();
+  const c = await config(), token = await accessToken();
+  const url = new URL(path, c.api_url); if (url.origin !== c.api_url) throw failure();
+  const headers = new Headers(init?.headers); headers.delete("apikey"); headers.set("Authorization", "Bearer " + token); headers.set("X-Clips-Installation", c.installation_id);
+  return fetch(url.toString(), { ...init, headers, credentials: "omit", cache: "no-store", redirect: "error" });
+}
+
+export async function remixIdentity(): Promise<GoIdentity> {
+  const response = await remixFetch("/auth/me"); if (!response.ok) throw failure();
+  return response.json();
+}
+
+export function clearRemixBlobs() { for (const value of blobs.values()) URL.revokeObjectURL(value); blobs.clear(); }
+export async function remixBlob(path: string): Promise<string> {
+  const cached = blobs.get(path); if (cached) return cached;
+  const response = await remixFetch(path);
+  if (!response.ok || !response.headers.get("Content-Type")?.startsWith("video/mp4") || Number(response.headers.get("Content-Length")) > 11 * 1024 * 1024) throw failure();
+  const blob = await response.blob(); if (blob.size > 11 * 1024 * 1024) throw failure();
+  const value = URL.createObjectURL(blob); blobs.set(path, value);
+  while (blobs.size > 3) { const first = blobs.keys().next().value!; URL.revokeObjectURL(blobs.get(first)!); blobs.delete(first); }
+  return value;
+}
+
+export async function logoutRemix(): Promise<void> {
+  const response = await remixFetch("/auth/logout", { method: "POST" });
+  if (!response.ok && response.status !== 401 && response.status !== 403) throw new Error("Não foi possível sair. Tente novamente.");
+  generation++; tokens = undefined; expiresAt = 0; refreshing = undefined; initialization = undefined; clearRemixBlobs();
+  await beginRemixLogin();
+}
+
+let resuming: Promise<boolean> | undefined;
+export function resumeRemixLogin(): Promise<boolean> {
+  if (!resuming) resuming = (async () => {
+    const response = await fetch("/auth/config", { credentials: "same-origin", cache: "no-store" });
+    if (!response.ok || !(await response.json()).remix_enabled) return false;
+    const result = await fetch("/auth/remix/continue", { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json" }, body: "{}", cache: "no-store" });
+    if (result.status === 204) return false;
+    if (!result.ok) throw new Error("Esta conta não tem acesso a esta instalação. Entre com a conta correta ou fale com a equipe.");
+    const data: { redirect_url: string } = await result.json();
+    const destination = new URL(data.redirect_url);
+    if (destination.protocol !== "https:" || destination.username || destination.password || destination.pathname !== "/login" || destination.search) throw failure();
+    const fragment = new URLSearchParams(destination.hash.slice(1));
+    if (!proof.test(fragment.get("clips_code") || "") || !proof.test(fragment.get("state") || "")) throw failure();
+    location.assign(destination.toString()); return true;
+  })().then(value => { if (!value) resuming = undefined; return value; }, error => { resuming = undefined; throw error; });
+  return resuming;
+}
