+    const { data: { subscription } } = supabase.auth.onAuthStateChange((_event, next) => { if (!initializing) void applySource(next); });
+    void (async () => {
+      try {
+        const local = await restoreNativeAccess();
+        if (!active) return;
+        if (local) { if (await resumeRemixLogin()) return; native.current = true; setUser(localUser(local)); setSession(null); setLoading(false); return; }
+        const { data } = await supabase.auth.getSession();
+        initializing = false; await applySource(data.session);
+      } catch { if (active) setLoading(false); }
+      finally { initializing = false; }
+    })();
+    const timer = setInterval(() => {
+      if (native.current) void refreshNativeAccess().catch(error => {
+        if (error?.status === 401 && active) { native.current = false; setUser(null); setSession(null); limparOrgCache(); }
+      });
+    }, 10 * 60_000);
+    return () => { active = false; clearInterval(timer); subscription.unsubscribe(); };
+  }, []);
+  const unavailable = async () => ({ error: Object.assign(new Error("Use o canal atual de atendimento para cadastro ou recuperação de senha."), { code: "clips_go_unavailable" }) });
+  const signIn = async (email: string, password: string) => {
+    try {
+      if (await usesNativeAuth(email)) {
+        const identity = await nativeSignIn(email, password);
+        if (await resumeRemixLogin()) return {error:null};
+        native.current = true; setSession(null); setUser(localUser(identity)); limparOrgCache();
+        return { error: null };
+      }
+      native.current = false;
+      const { data, error } = await supabase.auth.signInWithPassword({ email, password });
+      if (error) return { error };
+      if (!data.session) throw new Error("Não foi possível abrir sua sessão.");
+      await ensureGoAccess(data.session); if (await resumeRemixLogin()) return {error:null}; setSession(data.session); setUser(data.session.user); limparOrgCache();
+      return { error: null };
+    } catch (error) { return { error: error as Error }; }
+  };
+  const signOut = async () => {
+    try { await closeGoAccess(); }
+    catch (error) {
+      if ((error as { status?: number }).status !== 401) { toast({ title: "Não foi possível sair", description: "Confira sua conexão e tente novamente. Sua sessão ainda está aberta.", variant: "destructive" }); return; }
+    }
+    if (!native.current) { const { error } = await supabase.auth.signOut({ scope: "local" }); if (error) localStorage.removeItem("clips-go-source-auth"); }
+    native.current = false; setSession(null); setUser(null); limparOrgCache();
+  };
+  return <AuthContext.Provider value={{ user, session, loading, signIn, signOut, signUp: unavailable, resetPassword: unavailable }}>{children}</AuthContext.Provider>;
+}
+
+function RemixAuthProvider({children}:{children:React.ReactNode}) {
+  const [user,setUser]=useState<User|null>(null),[loading,setLoading]=useState(true),[error,setError]=useState("");
+  const framed = window.self !== window.top;
+  useEffect(()=>{
+    if (framed) return;
+    let active=true;
+    void initializeRemix().then(identity=>{if(identity&&active){setUser(localUser(identity));setLoading(false);limparOrgCache();}}).catch(()=>{if(active)setError("Não foi possível abrir este acesso. Confira o endereço com a equipe e tente novamente.");});
+    const timer=setInterval(()=>{void remixIdentity().catch(()=>{if(active){setUser(null);setError("Seu acesso expirou ou foi encerrado. Entre novamente para continuar.");}});},5*60_000);
+    return ()=>{active=false;clearInterval(timer);};
+  },[framed]);
+  const unavailable=async()=>({error:new Error("Use o canal atual de atendimento para cadastro ou recuperação de senha.")});
+  if (framed) return <div className="flex min-h-screen items-center justify-center bg-background p-6"><div className="max-w-md space-y-4"><p className="text-foreground">Abra o CLIPS em uma nova aba para entrar com segurança.</p><Button asChild><a href={location.origin+"/login"} target="_blank" rel="noopener noreferrer">Abrir CLIPS</a></Button></div></div>;
+  if(error)return <div className="flex min-h-screen items-center justify-center bg-background p-6"><div className="max-w-md space-y-4"><p role="alert" className="text-foreground">{error}</p><Button onClick={()=>void beginRemixLogin().catch(()=>setError("Este endereço ainda não foi liberado. Fale com a equipe."))}>Entrar novamente</Button></div></div>;
+  return <AuthContext.Provider value={{
+    user, session: null, loading,
+    signIn: async () => { await beginRemixLogin(); return { error: null }; },
+    signUp: unavailable, resetPassword: unavailable,
+    signOut: async () => { await logoutRemix(); setLoading(true); setUser(null); limparOrgCache(); },
+  }}>{children}</AuthContext.Provider>;
+}
+
+export function AuthProvider({ children }: { children: React.ReactNode }) {
+  if(REMIX_MODE)return <RemixAuthProvider>{children}</RemixAuthProvider>;
+  return GO_MODE ? <GoAuthProvider>{children}</GoAuthProvider> : <LegacyAuthProvider>{children}</LegacyAuthProvider>;
+}
