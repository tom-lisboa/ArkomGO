diff --git a/src/pages/Gifs.tsx b/src/pages/Gifs.tsx
new file mode 100644
index 0000000..d8fd3f3
--- /dev/null
+++ b/src/pages/Gifs.tsx
@@ -0,0 +1,168 @@
+import { useEffect, useState } from "react";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { REMIX_MODE } from "@/lib/go-mode";
+import { remixFetch } from "@/lib/go-remix";
+
+type Job = { id: string; status: "queued" | "running" | "done" | "failed" };
+type Status = { has_key: boolean; gift_remaining: number; gift_expires_at: string | null; jobs: Job[] };
+
+const labels = { queued: "Na fila", running: "Gerando", done: "Pronto", failed: "Falhou" };
+
+async function gifRequest(path = "", method = "GET", body?: object) {
+  const response = await (REMIX_MODE ? remixFetch : fetch)("/app/gifs" + path, {
+    method,
+    headers: body ? { "Content-Type": "application/json" } : undefined,
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  if (!response.ok) {
+    const { error } = await response.json().catch(() => ({}));
+    const messages: Record<string, string> = {
+      gif_unavailable: "A geração de GIFs está indisponível.",
+      invalid_openai_key: "Confira a chave da OpenAI.",
+      invalid_gif_prompt: "Descreva a animação em um texto mais curto.",
+      gif_credential_unavailable: "Configure sua chave ou confira o saldo do brinde.",
+      gif_capacity: "A fila de GIFs está cheia. Tente novamente em instantes.",
+      gif_already_pending: "Aguarde a geração em andamento.",
+    };
+    throw new Error(messages[error] ?? "Não foi possível concluir a operação.");
+  }
+  return response.status === 204 ? undefined : response.json();
+}
+
+function GifPreview({ path }: { path: string }) {
+  const [requested, setRequested] = useState(false);
+  const [preview, setPreview] = useState(REMIX_MODE ? "" : path);
+  const [error, setError] = useState(false);
+
+  useEffect(() => {
+    if (!requested) return;
+    const controller = new AbortController();
+    let objectURL: string | undefined;
+    async function load() {
+      try {
+        const response = await remixFetch(path, { signal: controller.signal });
+        if (!response.ok || response.headers.get("Content-Type") !== "image/gif" ||
+            Number(response.headers.get("Content-Length")) > 8 * 1024 * 1024) throw new Error();
+        const blob = await response.blob();
+        if (blob.size > 8 * 1024 * 1024) throw new Error();
+        if (controller.signal.aborted) return;
+        objectURL = URL.createObjectURL(blob);
+        setPreview(objectURL);
+      } catch {
+        if (!controller.signal.aborted) {
+          setError(true);
+          setRequested(false);
+        }
+      }
+    }
+    void load();
+    return () => {
+      controller.abort();
+      if (objectURL) URL.revokeObjectURL(objectURL);
+    };
+  }, [path, requested]);
+
+  if (!preview) return <>
+    <Button variant="outline" disabled={requested} onClick={() => { setError(false); setRequested(true); }}>
+      {requested ? "Carregando GIF…" : "Ver GIF"}
+    </Button>
+    {error && <p role="alert">Não foi possível carregar o GIF.</p>}
+  </>;
+  return <>
+    <img className="w-full rounded-lg" src={preview} alt="GIF gerado" loading="lazy" />
+    <a className="inline-block underline" href={preview} download="clips.gif">Baixar GIF</a>
+  </>;
+}
+
+export default function Gifs() {
+  const [status, setStatus] = useState<Status>();
+  const [key, setKey] = useState("");
+  const [prompt, setPrompt] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const pending = status?.jobs.some(job => job.status === "queued" || job.status === "running");
+
+  useEffect(() => {
+    let active = true;
+    const refresh = async () => {
+      try {
+        const next = await gifRequest();
+        if (active) setStatus(next);
+      } catch (err) {
+        if (active) setError((err as Error).message);
+      }
+    };
+    void refresh();
+    const timer = pending ? window.setInterval(refresh, 3000) : undefined;
+    return () => { active = false; window.clearInterval(timer); };
+  }, [pending]);
+
+  async function act(action: () => Promise<void>) {
+    setBusy(true);
+    setError("");
+    try {
+      await action();
+      setStatus(await gifRequest());
+    } catch (err) {
+      setError((err as Error).message);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const gift = status?.gift_remaining ?? 0;
+  return (
+    <main className="mx-auto max-w-3xl space-y-8 p-6 md:p-10">
+      <header>
+        <h1 className="text-3xl font-semibold">Gerar GIFs</h1>
+        <p className="mt-2 text-muted-foreground">Descreva uma animação curta e baixe o GIF quando estiver pronto.</p>
+      </header>
+      {error && <p role="alert" className="text-destructive">{error}</p>}
+      {status && <>
+        <form className="space-y-3 rounded-xl border p-4" onSubmit={event => {
+          event.preventDefault();
+          void act(async () => { await gifRequest("/key", "PUT", { key }); setKey(""); });
+        }}>
+          <label className="block font-medium" htmlFor="gif-key">Sua chave da OpenAI</label>
+          <Input id="gif-key" type="password" autoComplete="off" maxLength={1024} value={key}
+            onChange={event => setKey(event.target.value)} placeholder={status.has_key ? "Chave salva" : "sk-…"} />
+          <div className="flex flex-wrap gap-2">
+            <Button type="submit" disabled={busy || !key.trim()}>Salvar chave</Button>
+            {status.has_key && <Button type="button" variant="outline" disabled={busy} onClick={() => void act(async () => {
+              await gifRequest("/key", "DELETE");
+              setKey("");
+            })}>Remover chave</Button>}
+          </div>
+        </form>
+        {gift > 0 && status.gift_expires_at && <p className="rounded-xl bg-accent p-4">
+          Gerações de brinde disponíveis <strong>{gift}</strong>. Válidas até{" "}
+          {new Date(status.gift_expires_at).toLocaleString("pt-BR")}.
+        </p>}
+        <section className="space-y-3">
+          <label className="block font-medium" htmlFor="gif-prompt">O que deve acontecer no GIF?</label>
+          <textarea className="block min-h-24 w-full rounded-md border bg-background p-3" id="gif-prompt" value={prompt} maxLength={1500} onChange={event => setPrompt(event.target.value)}
+            placeholder="Um mascote robô acena e volta à pose inicial, com a câmera fixa." />
+          <div className="flex flex-wrap gap-2">
+            {gift > 0 && <Button disabled={busy || pending || !prompt.trim()} onClick={() =>
+              void act(async () => { await gifRequest("", "POST", { prompt, gift: true }); })}>Gerar com brinde</Button>}
+            {status.has_key && <Button variant={gift ? "outline" : "default"} disabled={busy || pending || !prompt.trim()} onClick={() =>
+              void act(async () => { await gifRequest("", "POST", { prompt, gift: false }); })}>Gerar com minha chave</Button>}
+          </div>
+        </section>
+        {status.jobs.length > 0 && <section className="space-y-3">
+          <h2 className="text-xl font-semibold">Gerações recentes</h2>
+          <ul className="grid gap-4 sm:grid-cols-2">
+            {status.jobs.map(job => {
+              const url = "/app/gifs/" + job.id + "/image";
+              return <li key={job.id} className="space-y-2 rounded-xl border p-3">
+                <p role="status">{labels[job.status]}</p>
+                {job.status === "done" && <GifPreview path={url} />}
+              </li>;
+            })}
+          </ul>
+        </section>}
+      </>}
+    </main>
+  );
+}
