new file mode 100644
index 0000000..8cf9f34
--- /dev/null
+++ b/src/lib/go-access.ts
@@ -0,0 +1,82 @@
+import type { Session } from "@supabase/supabase-js";
+import { supabase } from "@/integrations/supabase/client";
+import { REMIX_MODE } from "@/lib/go-mode";
+import { remixFetch, remixIdentity } from "@/lib/go-remix";
+
+export type GoIdentity = { id: string; source_user_id: string; email: string; display_name: string; workspace_id: string; session_expires_at: string; auth_provider: "local" | "supabase"; organization_id: string };
+let pending: Promise<GoIdentity> | null = null;
+let current: GoIdentity | null = null;
+
+const errors: Record<string, string> = {
+  customer_not_enabled: "Esta conta ainda não foi liberada para a homologação. O acesso ao CLIPS atual continua separado.",
+  identity_provider_unavailable: "Não conseguimos validar sua conta agora. Tente novamente em instantes.",
+  login_retry_later: "Aguarde alguns segundos e tente entrar novamente.",
+  invalid_credentials: "E-mail ou senha incorretos.",
+  invalid_source_session: "Sua sessão expirou. Entre novamente.",
+};
+
+export async function goRequest<T>(path: string, init?: RequestInit): Promise<T> {
+  const response = REMIX_MODE ? await remixFetch(path, init) : await fetch(path, { ...init, credentials: "same-origin" });
+  if (!response.ok) {
+    const body = await response.json().catch(() => ({}));
+    throw Object.assign(new Error(errors[body.error] || body.message || "Não foi possível concluir. Tente novamente."),
+      { code: body.error || "clips_go_unavailable", status: response.status });
+  }
+  return response.status === 204 ? undefined as T : response.json();
+}
+
+export async function ensureGoAccess(session: Session): Promise<GoIdentity> {
+  if (!pending) pending = (async () => {
+    const existing = await fetch("/auth/me", { credentials: "same-origin" });
+    if (existing.ok) {
+      const identity: GoIdentity = await existing.json();
+      if (identity.source_user_id === session.user.id && identity.email.toLowerCase() === session.user.email?.toLowerCase() && Date.parse(identity.session_expires_at) > Date.now() + 10 * 60_000) {
+        current = identity;
+        return identity;
+      }
+    }
+    current = await goRequest<GoIdentity>("/auth/session", {
+      method: "POST", headers: { "Content-Type": "application/json", Authorization: "Bearer " + session.access_token }, body: "{}",
+    });
+    return current;
+  })().finally(() => { pending = null; });
+  const identity = await pending;
+  if (identity.source_user_id !== session.user.id || identity.email.toLowerCase() !== session.user.email?.toLowerCase()) {
+    throw Object.assign(new Error(errors.customer_not_enabled), { code: "customer_not_enabled" });
+  }
+  return identity;
+}
+
+export async function getGoIdentity(): Promise<GoIdentity> {
+  if (REMIX_MODE) return remixIdentity();
+  if (current) return current;
+  const { data } = await supabase.auth.getSession();
+  if (!data.session) throw new Error("Entre novamente para continuar.");
+  return ensureGoAccess(data.session);
+}
+
+export async function closeGoAccess() {
+  current = null;
+  await goRequest("/auth/logout", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" });
+}
+
+export async function restoreNativeAccess(): Promise<GoIdentity | null> {
+  const response = await fetch("/auth/me", { credentials: "same-origin" });
+  if (response.status === 401) return null;
+  if (!response.ok) throw new Error("Não foi possível consultar sua sessão agora.");
+  const identity: GoIdentity = await response.json();
+  if (identity.auth_provider !== "local") return null;
+  current = identity; return identity;
+}
+export async function nativeSignIn(email: string, password: string): Promise<GoIdentity> {
+  current = await goRequest<GoIdentity>("/auth/login", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email, password }) });
+  return current;
+}
+export async function refreshNativeAccess(): Promise<GoIdentity> {
+  current = await goRequest<GoIdentity>("/auth/refresh", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" });
+  return current;
+}
+export async function usesNativeAuth(email: string): Promise<boolean> {
+  const configuration = await goRequest<{ local_domains: string[] }>("/auth/config");
+  return configuration.local_domains.includes(email.trim().toLowerCase().split("@").at(-1) || "");
+}
