+++ b/clips-homolog.config.ts
@@ -0,0 +1,29 @@
+const CENTRAL_REF = "auytmefqnuzbktyzcled";
+
+export function homologConnection(env: Record<string, string>, allowLoopback: boolean) {
+  const url = env.VITE_CLIPS_HOMOLOG_URL;
+  const key = env.VITE_CLIPS_HOMOLOG_PUBLISHABLE_KEY;
+  const instanceId = env.VITE_CLIPS_HOMOLOG_INSTANCE_ID;
+  if (!url || !key || !instanceId) {
+    throw new Error("CLIPS homolog: configure URL, publishable key and test instance explicitly.");
+  }
+
+  const target = new URL(url);
+  if (target.username || target.password || target.pathname !== "/" || target.search || target.hash) {
+    throw new Error("CLIPS homolog: the backend must be a bare origin.");
+  }
+  const local = allowLoopback && target.protocol === "http:" && target.hostname === "127.0.0.1" && !!target.port;
+  const ref = env.VITE_CLIPS_HOMOLOG_PROJECT_REF;
+  const hosted = ref && /^[a-z0-9]{20}$/.test(ref) && ref !== CENTRAL_REF &&
+    target.origin === `https://${ref}.supabase.co`;
+  if (!local && !hosted) {
+    throw new Error("CLIPS homolog: use a separate Supabase project matching the test ref.");
+  }
+  if (!/^sb_publishable_[A-Za-z0-9_-]+$/.test(key)) {
+    throw new Error("CLIPS homolog: use the test project's publishable key.");
+  }
+  if (!/^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(instanceId)) {
+    throw new Error("CLIPS homolog: the test instance must be a UUID.");
+  }
+  return { url: target.origin, key, instanceId };
+}
