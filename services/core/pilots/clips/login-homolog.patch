@@ -0,0 +1,36 @@
+import { describe, expect, it } from "vitest";
+import { homologConnection } from "../../../clips-homolog.config";
+
+const env = {
+  VITE_CLIPS_HOMOLOG_URL: "https://abcdefghijklmnopqrst.supabase.co",
+  VITE_CLIPS_HOMOLOG_PROJECT_REF: "abcdefghijklmnopqrst",
+  VITE_CLIPS_HOMOLOG_PUBLISHABLE_KEY: "sb_publishable_fixture",
+  VITE_CLIPS_HOMOLOG_INSTANCE_ID: "8d006a10-2194-40bd-b447-2ffb400ba066",
+};
+
+describe("isolamento do build CLIPS de homologação", () => {
+  it("aceita um projeto de teste explicitamente configurado", () => {
+    expect(homologConnection(env, false).url).toBe(env.VITE_CLIPS_HOMOLOG_URL);
+  });
+  it("recusa o projeto central mesmo com o ref correspondente", () => {
+    expect(() => homologConnection({ ...env,
+      VITE_CLIPS_HOMOLOG_URL: "https://auytmefqnuzbktyzcled.supabase.co",
+      VITE_CLIPS_HOMOLOG_PROJECT_REF: "auytmefqnuzbktyzcled",
+    }, false)).toThrow();
+  });
+  it("recusa ambiente ausente, ref diferente e chave privilegiada", () => {
+    expect(() => homologConnection({}, false)).toThrow();
+    expect(() => homologConnection({ ...env, VITE_CLIPS_HOMOLOG_PROJECT_REF: "incompatível" }, false)).toThrow();
+    expect(() => homologConnection({ ...env, VITE_CLIPS_HOMOLOG_PUBLISHABLE_KEY: "sb_secret_fixture" }, false)).toThrow();
+  });
+  it("recusa URL remota com caminho e instância sem UUID", () => {
+    expect(() => homologConnection({ ...env, VITE_CLIPS_HOMOLOG_URL: env.VITE_CLIPS_HOMOLOG_URL+"/other" }, false)).toThrow();
+    expect(() => homologConnection({ ...env, VITE_CLIPS_HOMOLOG_INSTANCE_ID: "" }, false)).toThrow();
+  });
+  it("habilita localhost somente por decisão explícita do processo de teste", () => {
+    const local = { ...env, VITE_CLIPS_HOMOLOG_URL: "http://127.0.0.1:18084" };
+    expect(() => homologConnection(local, false)).toThrow();
+    expect(homologConnection(local, true).url).toBe(local.VITE_CLIPS_HOMOLOG_URL);
+    expect(() => homologConnection({ ...local, VITE_CLIPS_HOMOLOG_URL: "http://192.168.0.1:18084" }, true)).toThrow();
+  });
+});
