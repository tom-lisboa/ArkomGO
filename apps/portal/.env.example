# Arkom — copie para .env.local e preencha somente no ambiente autorizado.
# Nunca commite chaves, URLs Postgres com senha ou dados reais.

# Produção usa o domínio canônico. Em desenvolvimento, sobrescreva ambos com
# http://localhost:3000 somente no seu .env.local.
APP_URL=https://app.arkom.ai
NEXT_PUBLIC_APP_URL=https://app.arkom.ai

# A pill Free/Pro é ferramenta de demo e fica desligada por padrão.
NEXT_PUBLIC_ARKOM_ENABLE_DEMO_PLAN=false

# Espaço de Networking (comentários) na página da aula. Desligado por padrão:
# quando false, o bloco de comentários não é renderizado. Flag client-side
# (inlined no build) — ligar (true) exige rebuild/redeploy.
NEXT_PUBLIC_ARKOM_ENABLE_COMMENTS=false

# Cliente público usado pela UI existente. A anon key não substitui autorização.
NEXT_PUBLIC_SUPABASE_URL=https://auytmefqnuzbktyzcled.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase CENTRAL — server-only (Auth, core, analytics e Storage).
CENTRAL_SUPABASE_URL=https://auytmefqnuzbktyzcled.supabase.co
CENTRAL_SUPABASE_ANON_KEY=
CENTRAL_SUPABASE_SERVICE_ROLE_KEY=

# Schema do runtime transacional. Config, não código (default: app_arkom).
#   app_arkom  → schema demo dedicado do arkom (comportamento atual; role LOGIN
#                membro apenas de arkom_runtime, sem BYPASSRLS).
#   educacional → schema central com os dados reais do bilhon-ai (o corte para o
#                 banco central). Requer a migration db/migrations/0008-central-parity.sql
#                 aplicada, ARKOM_DATABASE_URL apontando para o educacional
#                 (role educacional_app, BYPASSRLS) e MEDIA_BUCKET=bilhon-media.
ARKOM_RUNTIME_SCHEMA=app_arkom

# Postgres runtime no mesmo banco físico, com search_path definido por
# ARKOM_RUNTIME_SCHEMA. No modo app_arkom, use uma role LOGIN dedicada, membro
# apenas de arkom_runtime, sem ownership, SUPERUSER ou BYPASSRLS. No modo
# educacional, use a role educacional_app (BYPASSRLS). Pooler Session mode com SSL.
# Esta credencial é da aplicação; não a use para executar migrations.
ARKOM_DATABASE_URL=

# Credencial privilegiada usada somente pelo operador durante migrations.
# Não configure no runtime/deploy da aplicação e nunca exponha como NEXT_PUBLIC_*.
ARKOM_MIGRATION_DATABASE_URL=

# Seed apenas em development/test. O processo falha fechado em outros ambientes.
ARKOM_AUTO_SEED=false

# Segredo HMAC obrigatório da sessão arkom_session. Gere valor aleatório forte.
ARKOM_SESSION_SECRET=

# Chave Bearer do endpoint programático POST /api/admin/users (criação de aluno
# com senha temporária, para automações server-to-server). Mínimo 32 caracteres;
# sem a env o endpoint responde 503 (fail-closed). Gere valor aleatório forte,
# guarde apenas no gerenciador de secrets e NUNCA exponha como NEXT_PUBLIC_*.
ARKOM_USERS_API_KEY=

# Bucket privado isolado e modo de autenticação do Storage.
# Valores aceitos: arkom-media (default, modo app_arkom) ou bilhon-media (modo
# educacional — é onde apontam cover_url/resource.url dos dados reais). Qualquer
# outro valor é rejeitado pelo servidor.
MEDIA_BUCKET=arkom-media
# rls (recomendado p/ arkom-media): JWT do usuário + policies de storage.objects.
# service: para arkom-media, só em development/test (rejeitado em produção). Para
# bilhon-media (modo educacional) é PERMITIDO em produção — o bilhon-ai já serve
# toda a mídia por service role; o acesso segue gated por sessão na rota /api/media.
MEDIA_STORAGE_AUTH_MODE=rls

# --- Corte para o banco central (modo educacional) ---
# Para rodar o arkom-dash sobre os dados reais do bilhon-ai, defina o quarteto:
#   ARKOM_RUNTIME_SCHEMA=educacional
#   ARKOM_DATABASE_URL=<url do educacional, role educacional_app (BYPASSRLS)>
#   MEDIA_BUCKET=bilhon-media
#   MEDIA_STORAGE_AUTH_MODE=service   (bilhon-media é servido por service role,
#                                      igual ao bilhon-ai; as capas 401/404 em rls)
# Pré-requisito: db/migrations/0008-central-parity.sql aplicada por operador com
# direitos de owner. O flip do deploy PROD é go/no-go do dono (reversível: basta
# reverter as envs; o educacional fica intacto).

# ===================== Genesis (builder de soluções por IA) =====================
# As tabelas do builder (builder_prompt_configs / builder_solutions /
# builder_step_generations) vivem no schema `educacional` do MESMO Supabase central,
# compartilhado com o bilhon-ai. Conexão dedicada com search_path fixo em educacional.
# Use uma role LOGIN com acesso de leitura/escrita a esse schema, SSL, pooler Session.
EDUCACIONAL_DATABASE_URL=

# Provedor de IA do Genesis. Fiel ao bilhon-ai: OpenAI (via edge central).
#   openai    → gera pelas Edge Functions do central (bai_builder-llm), zero key local.
#   anthropic → chama a Anthropic direto (exige ANTHROPIC_API_KEY).
#   mock      → conteúdo determinístico, para testar o fluxo sem chave.
# Auto (se vazio): anthropic com key → openai com central → senão mock. Defina
# explicitamente `openai` para não cair no anthropic quando ANTHROPIC_API_KEY existir.
LLM_PROVIDER=openai
# Modelo OpenAI usado pela edge central (default do código: gpt-4o-mini).
AI_MODEL_OPENAI=gpt-4.1
# Opcional: Anthropic direto (só usado com LLM_PROVIDER=anthropic ou auto sem central).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Gestor IA — teto de perguntas por aluno em 24h (default do código: 50).
# Usa o MESMO provider/modelo do bloco acima (LLM_PROVIDER / AI_MODEL / AI_MODEL_OPENAI).
CONSULTOR_MAX_MSGS_24H=50

# --- OpenAI "central" (zero config) ---
# A OPENAI_API_KEY NÃO fica aqui: ela vive nos secrets das Edge Functions do Supabase
# CENTRAL (bai_builder-llm para geração, bai_builder-stt para transcrição de voz). O app
# só precisa de CENTRAL_SUPABASE_URL + CENTRAL_SUPABASE_SERVICE_ROLE_KEY (acima) para
# proxyar. Defina OPENAI_API_KEY abaixo APENAS como override opcional para chamar a
# OpenAI direto do app (ex.: dev sem acesso à edge). Modelo de transcrição: whisper-1.
OPENAI_API_KEY=
STT_MODEL=whisper-1
